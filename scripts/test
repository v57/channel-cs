#!/usr/bin/env bash
set -euo pipefail
# In the Hub checkout this runs in its toolchain container (HubTools/hub-run); elsewhere it runs here.
hub_run="$(dirname "$0")/../../../HubTools/hub-run"
[[ -n "${HUB_TOOLCHAIN:-}" || ! -x "$hub_run" ]] || exec "$hub_run" bash "$0" "$@"

cd "$(dirname "$0")/.."

# The QUIC tests need libmsquic: fetched once into the cache when the system has none (scripts/msquic)
if msquic=$(scripts/msquic) && [[ -n "$msquic" ]]; then
  export LD_LIBRARY_PATH="$msquic${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

dotnet test ChannelCs.slnx -c Release
